@startuml

title NetPulse - Diagrama de Clases

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45

skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #343A40
    FontColor #212529
}

skinparam enum {
    BackgroundColor #F1F3F5
    BorderColor #495057
}

skinparam ArrowColor #495057
skinparam ArrowFontColor #343A40

' =========================================================
' ENUMERACIONES
' =========================================================

enum EstadoConexion {
    ONLINE
    OFFLINE
}

enum TipoMantenimiento {
    PREVENTIVO
    CORRECTIVO
}

enum EstadoEmpleado {
    ACTIVO
    INACTIVO
}

' =========================================================
' USUARIOS Y ROLES
' =========================================================

class Rol <<Entity>> {
    - id: Integer
    - nombre: String
    - descripcion: String
    --
    + asignarUsuario(usuario: Usuario): void
    + actualizar(nombre: String, descripcion: String): void
}

class Usuario <<Entity>> {
    - id: Integer
    - nombre: String
    - correo: String
    - contrasena: String
    - activo: Boolean
    - fechaCreacion: LocalDateTime
    - ultimoAcceso: LocalDateTime
    --
    + registrar(): void
    + actualizarDatos(nombre: String, correo: String): void
    + cambiarContrasena(contrasena: String): void
    + activar(): void
    + desactivar(): void
    + registrarAcceso(): void
}

class Empleado <<Entity>> {
    - id: Integer
    - codigoEmpleado: String
    - departamento: String
    - cargo: String
    - telefono: String
    - fechaIngreso: LocalDate
    - estadoLaboral: EstadoEmpleado
    --
    + registrar(): void
    + actualizarDatos(): void
    + activar(): void
    + desactivar(): void
}

Rol "1" -- "0..*" Usuario : asigna
Usuario "1" -- "0..1" Empleado : corresponde

' =========================================================
' CATALOGOS DE EQUIPOS
' =========================================================

class TipoEquipo <<Entity>> {
    - id: Integer
    - nombre: String
    - descripcion: String
    --
    + crear(): void
    + actualizar(): void
}

class EstadoEquipo <<Entity>> {
    - id: Integer
    - nombre: String
    - descripcion: String
    --
    + crear(): void
    + actualizar(): void
}

' =========================================================
' EQUIPOS
' =========================================================

class Equipo <<Entity>> {
    - id: Integer
    - nombre: String
    - marca: String
    - modelo: String
    - numeroSerie: String
    - ubicacion: String
    - ipAddress: String
    - macAddress: String
    - estadoConexion: EstadoConexion
    - fechaRegistro: LocalDateTime
    --
    + registrar(): void
    + actualizarDatos(): void
    + asignarResponsable(usuario: Usuario): void
    + cambiarEstado(estado: EstadoEquipo): void
    + actualizarConexion(estado: EstadoConexion): void
}

TipoEquipo "1" -- "0..*" Equipo : clasifica
EstadoEquipo "1" -- "0..*" Equipo : define
Usuario "0..1" -- "0..*" Equipo : responsable

' =========================================================
' CATEGORIAS DE INCIDENCIAS
' =========================================================

class CategoriaIncidencia <<Entity>> {
    - id: Integer
    - nombre: String
    - descripcion: String
    - activo: Boolean
    --
    + crear(): void
    + actualizar(): void
    + activar(): void
    + desactivar(): void
}

' =========================================================
' CATALOGOS DE TICKETS
' =========================================================

class Prioridad <<Entity>> {
    - id: Integer
    - nombre: String
    --
    + crear(): void
    + actualizar(): void
}

class EstadoTicket <<Entity>> {
    - id: Integer
    - nombre: String
    - descripcion: String
    --
    + crear(): void
    + actualizar(): void
}

' =========================================================
' TICKETS
' =========================================================

class Ticket <<Entity>> {
    - id: Integer
    - descripcion: String
    - fechaCreacion: LocalDateTime
    - fechaAsignacion: LocalDateTime
    - fechaResolucion: LocalDateTime
    --
    + registrar(): void
    + asignarTecnico(usuario: Usuario): void
    + cambiarEstado(estado: EstadoTicket): void
    + cambiarPrioridad(prioridad: Prioridad): void
    + resolver(): void
}

Usuario "1" -- "0..*" Ticket : reporta
Usuario "0..1" -- "0..*" Ticket : atiende
Equipo "1" -- "0..*" Ticket : afecta
CategoriaIncidencia "1" -- "0..*" Ticket : clasifica
Prioridad "1" -- "0..*" Ticket : prioriza
EstadoTicket "1" -- "0..*" Ticket : define

' =========================================================
' MANTENIMIENTOS
' =========================================================

class Mantenimiento <<Entity>> {
    - id: Integer
    - tipo: TipoMantenimiento
    - descripcion: String
    - repuestos: String
    - fecha: LocalDateTime
    --
    + registrar(): void
    + actualizar(): void
    + finalizar(): void
}

Equipo "1" -- "0..*" Mantenimiento : recibe
Usuario "1" -- "0..*" Mantenimiento : realiza
Ticket "0..1" -- "0..*" Mantenimiento : origina

' =========================================================
' ALERTAS DE RED
' =========================================================

class AlertaRed <<Entity>> {
    - id: Integer
    - tipoEvento: String
    - mensaje: String
    - notificacionEnviada: Boolean
    - medioNotificacion: String
    - fecha: LocalDateTime
    --
    + generar(): void
    + enviarNotificacion(): void
    + marcarNotificacionEnviada(): void
}

Equipo "1" -- "0..*" AlertaRed : genera

' =========================================================
' HISTORIAL DE ESTADOS
' =========================================================

class HistorialEstado <<Entity>> {
    - id: Integer
    - estadoAnterior: EstadoEquipo
    - estadoNuevo: EstadoEquipo
    - fechaCambio: LocalDateTime
    - motivo: String
    --
    + registrarCambio(): void
}

Equipo "1" -- "0..*" HistorialEstado : registra
EstadoEquipo "1" -- "0..*" HistorialEstado : estado anterior
EstadoEquipo "1" -- "0..*" HistorialEstado : estado nuevo
Usuario "1" -- "0..*" HistorialEstado : modifica

@enduml