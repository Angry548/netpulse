@startuml

title NetPulse - Diagrama de Clases

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45

skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #343A40
    FontColor #212529
}

skinparam enum {
    BackgroundColor #F1F3F5
    BorderColor #495057
}

skinparam ArrowColor #495057
skinparam ArrowFontColor #343A40

' =========================================================
' ENUMERACIONES
' =========================================================

enum TipoEquipo {
    COMPUTADORA
    SERVIDOR
    ROUTER
    IMPRESORA
}

enum EstadoEquipo {
    ACTIVO
    EN_REPARACION
    FUERA_DE_SERVICIO
}

enum EstadoConexion {
    ONLINE
    OFFLINE
}

enum Prioridad {
    BAJA
    MEDIA
    ALTA
}

enum EstadoTicket {
    PENDIENTE
    EN_PROCESO
    RESUELTO
}

enum TipoMantenimiento {
    PREVENTIVO
    CORRECTIVO
}

enum EstadoEmpleado {
    ACTIVO
    INACTIVO
}

' =========================================================
' USUARIOS Y ROLES
' =========================================================

class Usuario {
    - id: Integer
    - nombre: String
    - correo: String
    - contrasena: String
    - activo: Boolean
    - fechaCreacion: DateTime
    - ultimoAcceso: DateTime

    + iniciarSesion(): Boolean
    + cerrarSesion(): void
}

class Rol {
    - id: Integer
    - nombre: String
    - descripcion: String
}

class Empleado {
    - id: Integer
    - codigoEmpleado: String
    - departamento: String
    - cargo: String
    - telefono: String
    - fechaIngreso: Date
    - estadoLaboral: EstadoEmpleado
}

Rol "1" -- "0..*" Usuario : asigna
Usuario "1" -- "0..1" Empleado : corresponde

' =========================================================
' EQUIPOS
' =========================================================

class Equipo {
    - id: Integer
    - nombre: String
    - tipo: TipoEquipo
    - marca: String
    - modelo: String
    - numeroSerie: String
    - ubicacion: String
    - ipAddress: String
    - macAddress: String
    - estado: EstadoEquipo
    - estadoConexion: EstadoConexion
    - fechaRegistro: DateTime

    + cambiarEstado(estado: EstadoEquipo): void
    + actualizarConexion(estado: EstadoConexion): void
}

Usuario "0..1" -- "0..*" Equipo : responsable

' =========================================================
' CATEGORÍAS DE INCIDENCIAS
' =========================================================

class CategoriaIncidencia {
    - id: Integer
    - nombre: String
    - descripcion: String
    - activo: Boolean
}

' =========================================================
' TICKETS
' =========================================================

class Ticket {
    - id: Integer
    - descripcion: String
    - prioridad: Prioridad
    - estado: EstadoTicket
    - fechaCreacion: DateTime
    - fechaAsignacion: DateTime
    - fechaResolucion: DateTime

    + asignarTecnico(usuario: Usuario): void
    + cambiarEstado(estado: EstadoTicket): void
    + cerrarTicket(): void
}

Usuario "1" -- "0..*" Ticket : reporta
Usuario "0..1" -- "0..*" Ticket : atiende
Equipo "1" -- "0..*" Ticket : relacionado
CategoriaIncidencia "1" -- "0..*" Ticket : clasifica

' =========================================================
' MANTENIMIENTOS
' =========================================================

class Mantenimiento {
    - id: Integer
    - fecha: DateTime
    - descripcion: String
    - tipo: TipoMantenimiento
    - repuestos: String

    + registrar(): void
}

Equipo "1" -- "0..*" Mantenimiento : recibe
Usuario "1" -- "0..*" Mantenimiento : realiza
Ticket "0..1" -- "0..*" Mantenimiento : origina

' =========================================================
' ALERTAS DE RED
' =========================================================

class AlertaRed {
    - id: Integer
    - tipoEvento: String
    - mensaje: String
    - fecha: DateTime
    - notificacionEnviada: Boolean
    - medioNotificacion: String

    + generar(): void
    + enviar(): void
}

Equipo "1" -- "0..*" AlertaRed : genera

' =========================================================
' HISTORIAL DE ESTADOS
' =========================================================

class HistorialEstado {
    - id: Integer
    - estadoAnterior: EstadoEquipo
    - estadoNuevo: EstadoEquipo
    - fechaCambio: DateTime
    - motivo: String
}

Equipo "1" -- "0..*" HistorialEstado : registra
Usuario "1" -- "0..*" HistorialEstado : realiza

@enduml